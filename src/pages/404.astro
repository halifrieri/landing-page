---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="That page doesn't exist.">
  <section class="mx-auto max-w-5xl px-6 py-28 sm:px-8 sm:py-36">
    <p class="font-display text-6xl text-muted">404</p>
    <h1 class="mt-4 text-title">That page doesn't exist.</h1>
    <p class="mt-4 max-w-(--measure) text-muted">
      It may have been part of the old version of this site.
    </p>
    <p class="mt-8">
      <a href="/" class="text-accent">Back to the homepage &rarr;</a>
    </p>
  </section>
</Base>
